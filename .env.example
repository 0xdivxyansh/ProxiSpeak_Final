# ==============================================================================
# Final Proxispeak - Environment Configuration Template
# Copy this file to .env before starting the services
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database & Cache Configuration
# MongoDB connection URI (e.g., mongodb://127.0.0.1:27017/proxispeak)
MONGODB_URI=mongodb://127.0.0.1:27017/final_proxispeak
# Redis connection URL (e.g., redis://127.0.0.1:6379)
REDIS_URL=redis://127.0.0.1:6379
# Fallback flag if Redis is temporarily unreachable (set to 'false' in strict production)
REDIS_REQUIRED=false

# Geospatial Proximity & Workspace Parameters (Virtual Office Planar Pixels)
WORKSPACE_WIDTH=1600
WORKSPACE_HEIGHT=1000
PROXIMITY_RADIUS=100
PROXIMITY_HYSTERESIS=10
MAX_MOVEMENT_SPEED_PPS=350

# WebRTC ICE Server Configuration
# STUN servers (comma separated)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN server credentials for symmetric NAT traversal
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Frontend Configuration (Vite automatically reads VITE_ prefixed keys)
VITE_BACKEND_URL=http://localhost:5000
VITE_PROXIMITY_RADIUS=100
VITE_WORKSPACE_WIDTH=1600
VITE_WORKSPACE_HEIGHT=1000
